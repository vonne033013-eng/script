<div class="workspace-view-panel" id="panelViewHandoff">
  <div class="handoff-header-banner">
    <div class="handoff-header-title">
      <h2>Project Handoffs</h2>
      <p>When going on leave, dynamically compile your pending deliverables, map backup mates and key responsibilities based on the projects registry, and instantly draft a synchronized handoff report.</p>
    </div>
  </div>

  <div class="handoff-split-grid">
    <div>
      <div class="handoff-card-box">
        <div class="handoff-card-title">PROJECT HANDOFF SPECIFICATIONS</div>
        <div class="form-row">
          <div class="form-group" style="grid-column: span 2;">
            <label class="form-label">Employee Name</label>
            <select class="form-select" id="handoffResourceUI" onchange="onHandoffResourceChange()"></select>
            <div id="suggestedLeavesContainer"></div>
          </div>
          <div class="form-group" style="grid-column: span 2;">
            <label class="form-label">MANUAL LEAVE DATE SELECTION</label>
            <input type="date" class="form-input" id="handoffDateUI" onchange="onHandoffDateChange()">
          </div>
        </div>
        <div class="diagnostics-box" id="diagnosticsInfoBox">
          <span class="material-icons-round">info</span>
          <div class="diagnostics-text">Select a resource and date to scan active projects for automated buddy routing.</div>
        </div>
      </div>

      <div class="handoff-card-box">
        <div class="handoff-card-title">
          <span>ACTIVE DELIVERABLES CHECKLIST</span>
        </div>
        <div id="checklistContainerUI">
          <div style="font-size:12px; color:var(--sub); padding:20px 0; text-align:center;">No pending deliverables compiled.</div>
        </div>
      </div>
    </div>

    <div>
      <div class="handoff-card-box" id="handoffDraftCardUI">
        <div class="handoff-card-title">
          <span style="display:flex; align-items:center; gap:6px; color:var(--primary);"><span class="material-icons-round" style="font-size:16px;">mail</span> LIVE PREVIEW OUTPUT</span>
          <span class="material-icons-round" style="color:var(--sub); font-size:16px; cursor:pointer;" onclick="copyHandoffToClipboard()" title="Copy entire draft to clipboard">content_copy</span>
        </div>
        
        <label class="form-label" style="display:block; margin-bottom:6px;">EMAIL SUBJECT</label>
        <input type="text" class="preview-input" id="previewSubjectUI" placeholder="Awaiting configuration...">
        
        <label class="form-label" style="display:block; margin-bottom:6px; margin-top:8px;">EMAIL MESSAGE BODY</label>
        <textarea class="preview-textarea" id="previewBodyUI" placeholder="Select a resource to generate the automated handoff body..."></textarea>
        
        <button class="btn-draft-email" id="executeDraftBtnUI" onclick="executeHandoffDraftGeneration()" disabled>
          <span class="material-icons-round" style="font-size:18px;">send</span> DRAFT/OPEN LEAVE HANDOFF EMAIL
        </button>
      </div>
    </div>
  </div>
</div>
